# ============================================================
# SIATC — Variables secretas para integración con sumarios-rc
# ============================================================
# Copiar este archivo como secrets.toml y completar los valores.
# En Streamlit Cloud: Settings → Secrets → pegar el contenido completo.
#
# NUNCA subir secrets.toml a Git (ya está en .gitignore).
# ============================================================

# ── Integración Supabase (sumarios-rc) ───────────────────────────────────────
# Obtener desde: https://app.supabase.com → tu proyecto → Settings → API
SUPABASE_URL = "https://XXXXXXXX.supabase.co"
SUPABASE_KEY = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.XXXXXXXX"

# Opcional: ID de dependencia por defecto para filtrar causas de RC
# (UUID de la dependencia en la tabla 'dependencias' de sumarios-rc)
# DEPENDENCIA_ID_DEFAULT = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
